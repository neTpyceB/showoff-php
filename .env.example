APP_NAME="Showoff PHP Core"
APP_CLI_NAME="showoff-core"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_CACHE_DIR=var/cache
APP_LOG_LEVEL=info
APP_SECRET=local-development-secret-key
APP_BUILD_COMMIT=
APP_URL="http://localhost:8081"
APP_SESSION_NAME="SHOWOFFSESSID"
APP_SESSION_COOKIE_SECURE=false
WEB_EXPOSE_PORT=8081
DB_EXPOSE_PORT=3307
REDIS_EXPOSE_PORT=6380
RABBITMQ_EXPOSE_PORT=5673
RABBITMQ_MANAGEMENT_EXPOSE_PORT=15673
DATABASE_DRIVER="mysql"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT=3306
DATABASE_NAME="showoff"
DATABASE_USER="showoff"
DATABASE_PASSWORD="showoff"
DATABASE_CHARSET="utf8mb4"
REDIS_DSN="tcp://127.0.0.1:6379"
RABBITMQ_HOST="127.0.0.1"
RABBITMQ_PORT=5672
RABBITMQ_USER="showoff"
RABBITMQ_PASSWORD="showoff"
RABBITMQ_VHOST="/"
RABBITMQ_QUEUE="contact_submission_events"
PERFORMANCE_HTTP_CACHE_MAX_AGE=30
PERFORMANCE_IDEMPOTENCY_TTL_SECONDS=600
PERFORMANCE_LOCK_TTL_SECONDS=15
PERFORMANCE_SLOW_REQUEST_MS=250
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_WINDOW_SECONDS=900
SECURITY_API_TOKEN_MAX_ATTEMPTS=10
SECURITY_API_TOKEN_WINDOW_SECONDS=900
