APP_NAME=Showoff PHP Core
APP_CLI_NAME=showoff-core
APP_ENV=prod
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_CACHE_DIR=/var/www/app/var/cache
APP_LOG_LEVEL=warning
APP_SECRET=replace-with-strong-32-byte-secret
APP_BUILD_COMMIT=
APP_URL=https://your-domain.example
APP_SESSION_NAME=SHOWOFFSESSID
APP_SESSION_COOKIE_SECURE=true
DATABASE_DRIVER=mysql
DATABASE_HOST=replace-db-host
DATABASE_PORT=3306
DATABASE_NAME=replace-db-name
DATABASE_USER=replace-db-user
DATABASE_PASSWORD=replace-db-password
DATABASE_CHARSET=utf8mb4
REDIS_DSN=tcp://replace-redis-host:6379
RABBITMQ_HOST=replace-rabbitmq-host
RABBITMQ_PORT=5672
RABBITMQ_USER=replace-rabbitmq-user
RABBITMQ_PASSWORD=replace-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=contact_submission_events
PERFORMANCE_HTTP_CACHE_MAX_AGE=30
PERFORMANCE_IDEMPOTENCY_TTL_SECONDS=600
PERFORMANCE_LOCK_TTL_SECONDS=15
PERFORMANCE_SLOW_REQUEST_MS=250
OBSERVABILITY_STRUCTURED_LOGGING_ENABLED=true
OBSERVABILITY_METRICS_TOKEN=replace-with-metrics-token
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_WINDOW_SECONDS=900
SECURITY_API_TOKEN_MAX_ATTEMPTS=10
SECURITY_API_TOKEN_WINDOW_SECONDS=900
