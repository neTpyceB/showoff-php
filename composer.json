{
    "name": "showoff-php/foundational-core",
    "description": "Foundational strict-typed PHP CLI application for runtime and configuration basics.",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "packages/config",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/health",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/console",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/http",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/persistence",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/domain",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": "^8.5",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/yaml": "^8.0",
        "showoff/config": "^1.0",
        "showoff/console": "^1.0",
        "showoff/health": "^1.0",
        "showoff/http": "^1.0",
        "showoff/domain": "^1.0",
        "showoff/persistence": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Showoff\\Core\\Bootstrap\\": "src/Bootstrap/",
            "Showoff\\Core\\Container\\": "src/Container/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Showoff\\Core\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/app",
        "bin/console"
    ],
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:coverage": "phpunit --configuration phpunit.xml --coverage-text",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
